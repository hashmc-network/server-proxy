+package net.md_5.bungee.util;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+import net.md_5.bungee.forge.ForgeConstants;
+import net.md_5.bungee.protocol.ProtocolConstants;
+import net.md_5.bungee.protocol.packet.PluginMessage;
+
+public final class PluginMessageChecks
+{
+
+    private static final int MAX_REGISTER_PAYLOAD_SIZE = Integer.getInteger( "zartema.maxRegisterPayloadSize", 8192 );
+    private static final int MAX_BRAND_PAYLOAD_SIZE = Integer.getInteger( "zartema.maxBrandPayloadSize", 256 );
+    private static final int MAX_LEGACY_PLUGIN_MESSAGE_SIZE = Integer.getInteger( "zartema.maxLegacyPluginMessageSize", 8192 );
+    private static final int MAX_REGISTER_CHANNELS_PER_MESSAGE = Integer.getInteger( "zartema.maxRegisterChannelsPerMessage", 64 );
+
+    private PluginMessageChecks()
+    {
+    }
+
+    public static void validateServerbound(PluginMessage pluginMessage, int protocolVersion, boolean forgeSupport)
+    {
+        String tag = pluginMessage.getTag();
+        byte[] data = pluginMessage.getData();
+
+        if ( isRegisterChannel( tag ) )
+        {
+            ensure( data.length <= MAX_REGISTER_PAYLOAD_SIZE, "REGISTER payload too large" );
+            return;
+        }
+
+        if ( isBrandChannel( tag ) )
+        {
+            ensure( data.length <= MAX_BRAND_PAYLOAD_SIZE, "Brand payload too large" );
+            return;
+        }
+
+        if ( isForgeChannel( tag ) )
+        {
+            ensure( forgeSupport, "Forge plugin messages are disabled" );
+            return;
+        }
+
+        if ( protocolVersion <= ProtocolConstants.MINECRAFT_1_12_2 )
+        {
+            ensure( data.length <= MAX_LEGACY_PLUGIN_MESSAGE_SIZE, "Legacy plugin message payload too large" );
+        }
+    }
+
+    public static List<String> readRegisteredChannels(PluginMessage pluginMessage, int channelLimit, int channelNameLimit)
+    {
+        byte[] data = pluginMessage.getData();
+        ensure( data.length <= MAX_REGISTER_PAYLOAD_SIZE, "REGISTER payload too large" );
+
+        String content = new String( data, StandardCharsets.UTF_8 );
+        String[] parts = content.split( "\0", -1 );
+        ensure( parts.length <= Math.min( channelLimit, MAX_REGISTER_CHANNELS_PER_MESSAGE ), "Too many channels in a single REGISTER payload" );
+
+        List<String> channels = new ArrayList<>( parts.length );
+        for ( String channel : parts )
+        {
+            validateChannelIdentifier( channel, channelNameLimit );
+            channels.add( channel );
+        }
+        return channels;
+    }
+
+    private static void validateChannelIdentifier(String channel, int channelNameLimit)
+    {
+        ensure( !channel.isEmpty(), "Channel name cannot be empty" );
+        ensure( channel.length() <= channelNameLimit, "Channel name too long" );
+
+        for ( int i = 0; i < channel.length(); i++ )
+        {
+            char c = channel.charAt( i );
+            ensure( c >= 33 && c <= 126, "Channel name contains invalid characters" );
+        }
+    }
+
+    private static boolean isRegisterChannel(String tag)
+    {
+        return "REGISTER".equals( tag ) || "UNREGISTER".equals( tag ) || "minecraft:register".equals( tag ) || "minecraft:unregister".equals( tag );
+    }
+
+    private static boolean isBrandChannel(String tag)
+    {
+        return "MC|Brand".equals( tag ) || "minecraft:brand".equals( tag );
+    }
+
+    private static boolean isForgeChannel(String tag)
+    {
+        return ForgeConstants.FML_TAG.equals( tag ) || ForgeConstants.FML_HANDSHAKE_TAG.equals( tag ) || ForgeConstants.FORGE_REGISTER.equals( tag );
+    }
+
+    private static void ensure(boolean condition, String message)
+    {
+        if ( !condition )
+        {
+            throw new IllegalArgumentException( message );
+        }
+    }
+}
