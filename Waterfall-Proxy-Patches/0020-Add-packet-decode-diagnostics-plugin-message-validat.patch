+    private void ensureDefaultMessagesFile(File file)
+    {
+        if ( file.exists() )
+        {
+            return;
+        }
+
+        try ( InputStream in = BungeeCord.class.getClassLoader().getResourceAsStream( "messages.template" ) )
+        {
+            if ( in == null )
+            {
+                getLogger().warning( "Bundled messages template could not be found" );
+                return;
+            }
+
+            Files.copy( in, file.toPath() );
+        } catch ( IOException ex )
+        {
+            getLogger().log( Level.SEVERE, "Could not create default messages.properties", ex );
+        }
+    }
+
+    private Map<String, String> loadCustomMessages(File file) throws IOException
+    {
+        List<String> lines = Files.readAllLines( file.toPath(), StandardCharsets.UTF_8 );
+        Map<String, String> messages = new LinkedHashMap<>();
+        String listKey = null;
+        List<String> listValues = new ArrayList<>();
+
+        for ( String rawLine : lines )
+        {
+            String trimmed = rawLine.trim();
+
+            if ( listKey != null )
+            {
+                if ( trimmed.isEmpty() || trimmed.startsWith( "#" ) )
+                {
+                    continue;
+                }
+
+                if ( trimmed.startsWith( "- " ) || trimmed.equals( "-" ) )
+                {
+                    String item = trimmed.length() > 1 ? trimmed.substring( 1 ).trim() : "";
+                    listValues.add( normaliseMessageValue( item ) );
+                    continue;
+                }
+
+                messages.put( listKey, String.join( "\n", listValues ) );
+                listKey = null;
+                listValues.clear();
+            }
+
+            if ( trimmed.isEmpty() || trimmed.startsWith( "#" ) )
+            {
+                continue;
+            }
+
+            int equalsIndex = rawLine.indexOf( '=' );
+            int colonIndex = rawLine.indexOf( ':' );
+
+            if ( equalsIndex >= 0 && ( colonIndex == -1 || equalsIndex < colonIndex ) )
+            {
+                String key = rawLine.substring( 0, equalsIndex ).trim();
+                String value = rawLine.substring( equalsIndex + 1 ).trim();
+                messages.put( key, normaliseMessageValue( value ) );
+                continue;
+            }
+
+            if ( colonIndex >= 0 )
+            {
+                String key = rawLine.substring( 0, colonIndex ).trim();
+                String value = rawLine.substring( colonIndex + 1 ).trim();
+                if ( value.isEmpty() )
+                {
+                    listKey = key;
+                } else
+                {
+                    messages.put( key, normaliseMessageValue( value ) );
+                }
+            }
+        }
+
+        if ( listKey != null )
+        {
+            messages.put( listKey, String.join( "\n", listValues ) );
+        }
+
+        return messages;
+    }
+
+    private void cacheCustomMessages(Map<String, Format> map, Map<String, String> messages)
+    {
+        for ( Map.Entry<String, String> entry : messages.entrySet() )
+        {
+            map.put( entry.getKey(), new MessageFormat( entry.getValue() ) );
+        }
+    }
+
+    private String normaliseMessageValue(String value)
+    {
+        String normalised = value;
+
+        if ( ( normalised.startsWith( "'" ) && normalised.endsWith( "'" ) ) || ( normalised.startsWith( "\"" ) && normalised.endsWith( "\"" ) ) )
+        {
+            normalised = normalised.substring( 1, normalised.length() - 1 );
+        }
+
+        normalised = normalised.replace( "\\n", "\n" );
+        return ChatColor.translateAlternateColorCodes( '&', normalised );
+    }
+
     private void cacheResourceBundle(Map<String, Format> map, ResourceBundle resourceBundle)
     {
         Enumeration<String> keys = resourceBundle.getKeys();
         while ( keys.hasMoreElements() )
         {
-            map.computeIfAbsent( keys.nextElement(), (key) -> new MessageFormat( resourceBundle.getString( key ) ) );
+            map.computeIfAbsent( keys.nextElement(), (key) -> new MessageFormat( ChatColor.translateAlternateColorCodes( '&', resourceBundle.getString( key ) ) ) );
         }
     }
 
