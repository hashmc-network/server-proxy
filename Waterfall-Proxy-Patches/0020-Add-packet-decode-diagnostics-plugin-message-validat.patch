     public boolean incrementAndCheck(int size)
     {
-        counter++;
-        dataCounter += size;
+        long nowNanos = System.nanoTime();
+        long nowMillis = System.currentTimeMillis();
 
-        if ( ( limit > 0 && counter > limit ) || ( dataLimit > 0 && dataCounter > dataLimit ) )
+        if ( lastRefillNanos == 0L )
+        {
+            lastRefillNanos = nowNanos;
+            windowStartMillis = nowMillis;
+            packetBudget = limit;
+            dataBudget = dataLimit;
+        } else
         {
-            long now = System.currentTimeMillis();
-            if ( nextSecond > now )
+            double elapsedSeconds = ( nowNanos - lastRefillNanos ) / 1_000_000_000D;
+            lastRefillNanos = nowNanos;
+
+            if ( limit > 0 )
+            {
+                packetBudget = Math.min( limit, packetBudget + ( elapsedSeconds * limit ) );
+            }
+            if ( dataLimit > 0 )
+            {
+                dataBudget = Math.min( dataLimit, dataBudget + ( elapsedSeconds * dataLimit ) );
+            }
+            if ( nowMillis - windowStartMillis >= 1000L )
             {
-                return false;
+                counter = 0;
+                dataCounter = 0;
+                windowStartMillis = nowMillis;
             }
-            nextSecond = now + 1000;
-            counter = 0;
-            dataCounter = 0;
         }
+
+        counter++;
+        dataCounter += size;
+
+        if ( ( limit > 0 && packetBudget < 1D ) || ( dataLimit > 0 && dataBudget < size ) )
+        {
+            return false;
+        }
+
+        if ( limit > 0 )
+        {
+            packetBudget -= 1D;
+        }
+        if ( dataLimit > 0 )
+        {
+            dataBudget -= size;
+        }
+
         return true;
     }
