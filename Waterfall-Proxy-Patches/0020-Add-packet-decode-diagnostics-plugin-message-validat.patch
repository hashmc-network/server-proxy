+    // Zartema start: describes the state of the connection when a decoder error happens
+    private String describeConnection()
+    {
+        ChannelWrapper channel = this.channel;
+        if ( channel == null )
+        {
+            return "unknown (channel not initialised)";
+        }
+
+        StringBuilder context = new StringBuilder();
+        context.append( "remote=" ).append( channel.getRemoteAddress() );
+
+        MinecraftDecoder decoder = channel.getMinecraftDecoder();
+        if ( decoder != null )
+        {
+            context.append( ", decodePhase=" ).append( decoder.getProtocol() );
+            context.append( ", decodeDirection=" ).append( decoder.isServer() ? "TO_SERVER" : "TO_CLIENT" );
+            context.append( ", protocolVersion=" ).append( decoder.getProtocolVersion() );
+            context.append( ", forgeSupport=" ).append( decoder.isSupportsForge() );
+        } else
+        {
+            context.append( ", decodePhase=unknown" );
+        }
+
+        MinecraftEncoder encoder = channel.getMinecraftEncoder();
+        if ( encoder != null )
+        {
+            context.append( ", encodePhase=" ).append( encoder.getProtocol() );
+        }
+
+        context.append( ", handler=" ).append( ( handler == null ) ? "none" : handler.getClass().getSimpleName() );
+        context.append( ", closing=" ).append( channel.isClosing() );
+
+        return context.toString();
+    }
+    // Zartema end
+
