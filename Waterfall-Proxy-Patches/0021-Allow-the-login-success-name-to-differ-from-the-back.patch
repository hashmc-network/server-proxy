From dca3e9523b4686ad5fb097c4909b85ea9b98dd93 Mon Sep 17 00:00:00 2001
From: Samuel Henrique <150966678+zyypj@users.noreply.github.com>
Date: Sat, 5 Sep 2026 17:07:53 -0300
Subject: [PATCH] Allow the login success name to differ from the backend name.


diff --git a/api/src/main/java/net/md_5/bungee/api/connection/PendingConnection.java b/api/src/main/java/net/md_5/bungee/api/connection/PendingConnection.java
index 507ca46f..28eecb73 100644
--- a/api/src/main/java/net/md_5/bungee/api/connection/PendingConnection.java
+++ b/api/src/main/java/net/md_5/bungee/api/connection/PendingConnection.java
@@ -18,6 +18,26 @@ public interface PendingConnection extends Connection
      */
     String getName();
 
+    /**
+     * Get the username sent back to the client in the login success packet.
+     *
+     * <p>Defaults to {@link #getName()}. Overriding it makes the client believe it owns a different
+     * profile name, while the backend server keeps receiving the real one.</p>
+     *
+     * @return the username the client is told it has
+     */
+    String getClientName();
+
+    /**
+     * Set the username sent back to the client in the login success packet.
+     *
+     * <p>Only has an effect while the connection is still logging in, so it must be set no later
+     * than {@link net.md_5.bungee.api.event.LoginEvent}. A null value restores {@link #getName()}.</p>
+     *
+     * @param clientName the username the client should be told it has
+     */
+    void setClientName(String clientName);
+
     /**
      * Get the numerical client version of the player attempting to log in.
      *
diff --git a/proxy/src/main/java/net/md_5/bungee/ServerConnector.java b/proxy/src/main/java/net/md_5/bungee/ServerConnector.java
index 28d6784f..53d230f6 100644
--- a/proxy/src/main/java/net/md_5/bungee/ServerConnector.java
+++ b/proxy/src/main/java/net/md_5/bungee/ServerConnector.java
@@ -452,7 +452,7 @@ public class ServerConnector extends PacketHandler
             } else
             {
                 LoginResult loginProfile = user.getPendingConnection().getLoginProfile();
-                user.unsafe().sendPacket( new LoginSuccess( user.getRewriteId(), user.getName(), ( loginProfile == null ) ? null : loginProfile.getProperties(), user.getSessionId() ) );
+                user.unsafe().sendPacket( new LoginSuccess( user.getRewriteId(), user.getPendingConnection().getClientName(), ( loginProfile == null ) ? null : loginProfile.getProperties(), user.getSessionId() ) );
                 user.getCh().setEncodeProtocol( Protocol.CONFIGURATION );
             }
         }
diff --git a/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java b/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
index 1acb0d8d..e8674f82 100644
--- a/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
+++ b/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
@@ -154,6 +154,7 @@ public class InitialHandler extends PacketHandler implements PendingConnection
     private String name;
     @Getter
     private UUID uniqueId;
+    private String clientName;
     @Getter
     private UUID offlineId;
     @Getter
@@ -698,7 +699,7 @@ public class InitialHandler extends PacketHandler implements PendingConnection
 
                 if ( getVersion() < ProtocolConstants.MINECRAFT_1_20_2 )
                 {
-                    unsafe.sendPacket( new LoginSuccess( getRewriteId(), getName(), ( loginProfile == null ) ? null : loginProfile.getProperties(), null ) );
+                    unsafe.sendPacket( new LoginSuccess( getRewriteId(), getClientName(), ( loginProfile == null ) ? null : loginProfile.getProperties(), null ) );
                     ch.setProtocol( Protocol.GAME );
                 }
                 finish2();
@@ -829,6 +830,18 @@ public class InitialHandler extends PacketHandler implements PendingConnection
         }
     }
 
+    @Override
+    public String getClientName()
+    {
+        return ( clientName != null ) ? clientName : getName();
+    }
+
+    @Override
+    public void setClientName(String clientName)
+    {
+        this.clientName = clientName;
+    }
+
     @Override
     public String getName()
     {
-- 
